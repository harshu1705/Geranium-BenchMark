ndings.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="3168"/><w:gridCol w:w="3168"/><w:gridCol w:w="3168"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1440"/><w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Standard</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="5616"/><w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>What was found</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2448"/><w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Error rate then</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1440"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>4.2</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="5616"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Written decision not issued within thirty days of the completed proof of loss.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2448"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>11.4 percent</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1440"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>4.3</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="5616"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Payment not made within ten working days of the signed release.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2448"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>9.2 percent</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:spacing w:after="120" w:before="120"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>No other standard was a finding in that examination. The company gave the Commissioner an undertaking to correct both.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="260"/></w:pPr><w:r><w:rPr><w:b/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="21"/></w:rPr><w:t>The company's answer to the request for files</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>The Division asked the company on 12/18/2025 for the claim files of which it received notice during the 2025 calendar year, together with its complaint register for the year. The company produced both on 01/22/2026 under cover of a letter signed by its vice president for claims, which states that the production is complete and that the register is the whole of the register for the year.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>The Division has not audited the production. The examiner tests what was produced against this file and against the standards.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="260"/></w:pPr><w:r><w:rPr><w:b/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="21"/></w:rPr><w:t>How the Division forwards a complaint</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>A complaint received by the Division against an authorized company is entered in the Division's register, given a reference in the form shown above, and forwarded to the company by electronic transmission to the address the company has designated for the purpose. The company is required to acknowledge receipt within five working days and to enter the complaint in its own register on receipt. The Division retains the transmission record and the acknowledgment for every complaint it forwards, and both are on this file for each of the complaints listed above.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>The Division's register is the record of what was forwarded. Where a company's register and the Division's register disagree about whether a complaint was forwarded, the question is settled by the Division's transmission record and not by the company's recollection.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="260"/></w:pPr><w:r><w:rPr><w:b/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="21"/></w:rPr><w:t>The order made on the previous examination</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>The Commissioner's order adopting the previous report required the company to file a corrective action plan for each standard found, to report quarterly on its progress for four quarters, and to submit to a further examination at the Commissioner's discretion. The company filed a plan for each of the two standards and made all four quarterly reports. The Division took no further action at the time and has formed no view, before this examination, on whether either plan worked.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="260"/></w:pPr><w:r><w:rPr><w:b/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="21"/></w:rPr><w:t>What this file does not contain</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120" w:before="0"/></w:pPr><w:r><w:rPr><w:b w:val="0"/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="20"/></w:rPr><w:t>The Division holds no record of any complaint about this company from a source other than a consumer complaint forwarded as described above. It holds no examination of the company's underwriting, rating or policyholder service, none having been conducted. Nothing on this file bears on the accuracy of the dates in the company's own claim system, which the Division has not tested and does not warrant.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:before="260"/></w:pPr><w:r><w:rPr><w:b/><w:i w:val="0"/><w:color w:val="1A1A1A"/><w:sz w:val="21"/></w:rPr><w:t>Dates fixed for this examination</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="4752"/><w:gridCol w:w="4752"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4896"/><w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Item</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4608"/><w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Date</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4896"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Examination period begins</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4608"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>01/01/2025</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4896"/></w:tcPr><w:p><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="18"/></w:rPr><w:t>Examination period ends</w:t></w:r></w:p></w:tc