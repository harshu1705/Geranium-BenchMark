r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>$10,550,680</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>7.84%</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>Floor Plan Loan</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>2</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>$7,194,920</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>5.35%</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>Agricultural Term Loan</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>1</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>$2,193,810</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:t>1.63%</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:t>Three relationship officers carry the portfolio: Diana Flores (11 loans, $27,512,145, 20.43%), Marcus Webb (9 loans, $25,074,404, 18.62%), and James Trotter (9 loans, $82,101,025, 60.97%). Geographic coverage spans the Midwest, Southeast, Southwest, Pacific Northwest, and Mid-Atlantic regions.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="240" w:after="80"/></w:pPr><w:r><w:t>3. Covenant Compliance Findings</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:t>All 29 loans were evaluated independently against their loan-specific DSCR, LTV, and Current Ratio thresholds as documented in the Covenant Compliance Workbook. Pre-calculated workbook values were cross-checked against the underlying financial statements and appraisal records to confirm accuracy. Where workbook values and independently computed values differed, the independently derived figure was used and the variance is noted. Nine individual breaches were identified across six affected loans.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="240" w:after="80"/></w:pPr><w:r><w:t>DSCR Breaches</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:t>Three loans fall below their loan-specific DSCR minimums as set out in the Covenant Compliance Workbook. LN-008 is severely distressed at 0.81x, well below its 1.20x floor.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="1728"/><w:gridCol w:w="1728"/><w:gridCol w:w="1728"/><w:gridCol w:w="1728"/><w:gridCol w:w="1728"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Loan ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Borrower</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Actual DSCR</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Min Threshold</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Variance</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>LN-001</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>ABC Industrial LLC</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>1.07x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>1.20x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>-0.13x</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>LN-004</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>Delta Auto Group</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>1.14x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>1.20x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>-0.06x</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>LN-008</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>Eta Print &amp; Packaging Inc.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>0.81x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>1.20x</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1728"/></w:tcPr><w:p><w:r><w:t>-0.39x</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:t>DSCR values were independently verified from Borrower_Financial_Statements_Summary.xlsx by dividing Net Operating Income by Total Annual Debt Service: LN-001 $347,200 / $324,500 = 1.07x; LN-004 $288,100 / $252,700 = 1.14x; LN-008 $74,800 / $92,400 = 0.81x. These computed values match the Covenant Compliance Workbook pre-calculated figures within rounding tolerance (±0.01x). No material conflict was identified.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="240" w:after="80"/></w:pPr><w:r><w:t>LTV Breaches</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:t>Three loans exceed their loan-specific LTV maximums based on current outstanding balances from the Loan Register and latest appraised collateral values from the Appraisal and Collate